{<<"name">>,<<"graphlaw_ex">>}.
{<<"version">>,<<"0.1.0">>}.
{<<"description">>,
 <<"BEAM bridge for the graphlaw WASM law kernel. The BEAM side holds only\nthe wasm byte-slice; all law admission happens inside the module\n(deterministic turnstile boundary).">>}.
{<<"elixir">>,<<"~> 1.14">>}.
{<<"app">>,<<"graphlaw_ex">>}.
