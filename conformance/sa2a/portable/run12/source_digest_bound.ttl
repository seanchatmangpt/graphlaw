@prefix sa2a: <https://seanchatmangpt.github.io/sa2a#> .
@prefix ex: <urn:graphlaw:sa2a:portable:> .
ex:source_digest_bound a sa2a:PortableConformanceVector ;
  sa2a:caseName "source_digest_bound" ;
  sa2a:assertionPredicate "sourceDigest" ;
  sa2a:assertionValue "SHA256" ;
  sa2a:authority "NONE" ;
  sa2a:consequence "EVIDENCE_ONLY" ;
  sa2a:canonicalization "RDFC-1.0" ;
  sa2a:expectedDecision "ADMIT" .
