	<owl:Ontology rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/NorthAmericanEntities/USExampleExecutives/">
		<rdfs:label>US Example Executives</rdfs:label>
		<dct:abstract>This ontology includes example corporate executives and other people to demonstrate how to model them using FIBO.</dct:abstract>
		<dct:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://opensource.org/licenses/MIT</dct:license>
