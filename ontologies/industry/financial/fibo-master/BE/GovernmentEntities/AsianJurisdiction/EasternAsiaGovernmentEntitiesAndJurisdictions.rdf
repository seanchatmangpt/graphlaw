	<owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/AsianJurisdiction/EasternAsiaGovernmentEntitiesAndJurisdictions/StateOfMongolia">
		<rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/SovereignState"/>
		<rdfs:label>state of Mongolia</rdfs:label>
