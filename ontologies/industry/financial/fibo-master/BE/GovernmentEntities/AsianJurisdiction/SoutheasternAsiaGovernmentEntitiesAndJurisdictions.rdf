	</owl:NamedIndividual>
	
	<owl:NamedIndividual rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/AsianJurisdiction/SoutheasternAsiaGovernmentEntitiesAndJurisdictions/JurisdictionOfTheDemocraticRepublicOfTimor-Leste">
