		<skos:definition>sovereign state and polity that is Poland</skos:definition>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/Poland"/>
		<fibo-be-ge-ge:isRepresentedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/EasternEuropeGovernmentEntitiesAndJurisdictions/GovernmentOfTheRepublicOfPoland"/>
	</owl:NamedIndividual>
	
