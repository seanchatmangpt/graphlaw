		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/BouvetIsland"/>
		<fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/Norway"/>
