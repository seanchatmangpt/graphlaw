gle:ex-hooks-inline-pack a gle:OpExample ; gle:exampleId "hooks.inline-pack" ; gle:forOp gle:op-hooks ; gle:description "An inline kh pack derives a B for every A and reports its firing." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:x a ex:A .\"},\"op\":\"hooks\",\"pack\":{\"dialect\":\"turtle\",\"text\":\"@prefix kh: <http://seanchatmangpt.github.io/graphlaw/kh#> . @prefix ex: <https://e/> .\\nex:h a kh:Hook ; kh:kind \\\"sparql\\\" ; kh:effect \\\"emit-delta\\\" ; kh:action ex:a ;\\n  kh:query \\\"SELECT ?x WHERE { ?x a <https://e/A> }\\\" .\\nex:a a kh:Action ; kh:handler <http://seanchatmangpt.github.io/graphlaw/handler#sparql-construct> ;\\n  kh:query \\\"CONSTRUCT { ?x a <https://e/B> } WHERE { ?x a <https://e/A> }\\\" .\\n\"}}" ; gle:positiveControl true .
gle:ex-hooks-no-match a gle:OpExample ; gle:exampleId "hooks.no-match" ; gle:forOp gle:op-hooks ; gle:description "A pack over data it does not match fires nothing." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:x a ex:Z .\"},\"op\":\"hooks\",\"pack\":{\"dialect\":\"turtle\",\"text\":\"@prefix kh: <http://seanchatmangpt.github.io/graphlaw/kh#> . @prefix ex: <https://e/> .\\nex:h a kh:Hook ; kh:kind \\\"sparql\\\" ; kh:effect \\\"emit-delta\\\" ; kh:action ex:a ;\\n  kh:query \\\"SELECT ?x WHERE { ?x a <https://e/A> }\\\" .\\nex:a a kh:Action ; kh:handler <http://seanchatmangpt.github.io/graphlaw/handler#sparql-construct> ;\\n  kh:query \\\"CONSTRUCT { ?x a <https://e/B> } WHERE { ?x a <https://e/A> }\\\" .\\n\"}}" ; gle:positiveControl false .
gle:ex-hooks-unsupported-kind-refused a gle:OpExample ; gle:exampleId "hooks.unsupported-kind-refused" ; gle:forOp gle:op-hooks ; gle:description "A hook with an unsupported kh:kind is refused, not skipped." ; gle:outcome "refused" ; gle:refusalKind "Unsupported" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:x a ex:A .\"},\"op\":\"hooks\",\"pack\":{\"dialect\":\"turtle\",\"text\":\"@prefix kh: <http://seanchatmangpt.github.io/graphlaw/kh#> . @prefix ex: <https://e/> .\\nex:h a kh:Hook ; kh:kind \\\"datalog\\\" ; kh:effect \\\"emit-delta\\\" ; kh:action ex:a ;\\n  kh:query \\\"SELECT ?x WHERE { ?x a <https://e/A> }\\\" .\\nex:a a kh:Action ; kh:handler <http://seanchatmangpt.github.io/graphlaw/handler#sparql-construct> ;\\n  kh:query \\\"CONSTRUCT { ?x a <https://e/B> } WHERE { ?x a <https://e/A> }\\\" .\\n\"}}" ; gle:positiveControl false .
