# graphlaw-elixir.ttl - graphlaw_ex (Elixir host) facts as data.
# Namespace: gle: <https://graphlaw.dev/elixir#> (distinct from gl: <https://graphlaw.dev/governance#> in
# graphlaw-governance.ttl; the two files share no prefix). No blank nodes.
# Sources read: graphlaw_ex/lib/graphlaw_ex/{telemetry,introspection,config,wasm_config}.ex,
# graphlaw_ex/mix.exs, graphlaw_ex/priv/graphlaw/MANIFEST.json, registry/op-examples.json,
# registry/ARTIFACTS.blake3, .github/workflows/elixir.yml.
# OpExample rows are a projection of registry/op-examples.json; re-project, never hand-edit rows.
# Sync direction: gle:ecm-* (ErrorClassMap) and gle:op-* (Op) rows MIRROR registry/capability-registry.json
# (refusal_kind_classes, ops; emitted as gac: rows by src/registry/emit_ttl.rs). The registry is the
# source; src/registry/emit_ttl.rs test elixir_ttl_mirror_rows_equal_registry fails on drift.
# Event names are dotted; split on "." for the segment list.

@prefix gle: <https://graphlaw.dev/elixir#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gle:ElixirModule a rdfs:Class ; rdfs:label "Elixir module" .
gle:TelemetryEvent a rdfs:Class ; rdfs:label "Telemetry event" .
gle:MetadataKey a rdfs:Class ; rdfs:label "Telemetry metadata key" .
gle:ConfigKey a rdfs:Class ; rdfs:label "config :graphlaw_ex key" .
gle:ErrorClassMap a rdfs:Class ; rdfs:label "Refusal kind to Splode class row" .
gle:LimitScope a rdfs:Class ; rdfs:label "Introspection limit scope row" .
gle:Op a rdfs:Class ; rdfs:label "Registry op" .
gle:OpExample a rdfs:Class ; rdfs:label "Registry op example" .
gle:Artifact a rdfs:Class ; rdfs:label "Pinned artifact" .
gle:CiMatrix a rdfs:Class ; rdfs:label "CI matrix" .
gle:CiPair a rdfs:Class ; rdfs:label "Elixir/OTP pair" .
gle:License a rdfs:Class ; rdfs:label "License" .
gle:HexPackage a rdfs:Class ; rdfs:label "Hex package" .
gle:Redaction a rdfs:Class ; rdfs:label "Telemetry redaction policy" .

gle:mod-Telemetry a gle:ElixirModule ; rdfs:label "GraphlawEx.Telemetry" .
gle:mod-EngineLoad a gle:ElixirModule ; rdfs:label "GraphlawEx.EngineLoad" .
gle:mod-Host a gle:ElixirModule ; rdfs:label "GraphlawEx.Host" .

gle:redaction-default a gle:Redaction ;
    rdfs:label "GraphlawEx.Telemetry.redact/1" ;
    gle:maxPlainBytes 128 ;
    gle:summaryShape "bytes,sha256" .

# --- metadata keys ---

gle:mk-nquads a gle:MetadataKey ; gle:keyName "nquads" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-sparql a gle:MetadataKey ; gle:keyName "sparql" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-sql a gle:MetadataKey ; gle:keyName "sql" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-query a gle:MetadataKey ; gle:keyName "query" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-payload a gle:MetadataKey ; gle:keyName "payload" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-request a gle:MetadataKey ; gle:keyName "request" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-body a gle:MetadataKey ; gle:keyName "body" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-data a gle:MetadataKey ; gle:keyName "data" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-lease a gle:MetadataKey ; gle:keyName "lease" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-lease-secret a gle:MetadataKey ; gle:keyName "lease_secret" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-secret a gle:MetadataKey ; gle:keyName "secret" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-token a gle:MetadataKey ; gle:keyName "token" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-password a gle:MetadataKey ; gle:keyName "password" ; gle:sensitive true ; gle:redactAs "summary" .
gle:mk-op a gle:MetadataKey ; gle:keyName "op" ; gle:sensitive false ; gle:redactAs "plainIfShort" .
gle:mk-server a gle:MetadataKey ; gle:keyName "server" ; gle:sensitive false ; gle:redactAs "passthrough" .
gle:mk-source-digest a gle:MetadataKey ; gle:keyName "source_digest" ; gle:sensitive false ; gle:redactAs "plainIfShort" .
gle:mk-outcome a gle:MetadataKey ; gle:keyName "outcome" ; gle:sensitive false ; gle:redactAs "plainIfShort" .
gle:mk-refusal-code a gle:MetadataKey ; gle:keyName "refusal_code" ; gle:sensitive false ; gle:redactAs "plainIfShort" .
gle:mk-kind a gle:MetadataKey ; gle:keyName "kind" ; gle:sensitive false ; gle:redactAs "plainIfShort" .
gle:mk-reason a gle:MetadataKey ; gle:keyName "reason" ; gle:sensitive false ; gle:redactAs "exceptionDescriptor" .
gle:mk-stacktrace a gle:MetadataKey ; gle:keyName "stacktrace" ; gle:sensitive false ; gle:redactAs "strippedFrames" .
gle:mk-code a gle:MetadataKey ; gle:keyName "code" ; gle:sensitive false ; gle:redactAs "plainIfShort" .
gle:mk-wasm-sha256 a gle:MetadataKey ; gle:keyName "wasm_sha256" ; gle:sensitive false ; gle:redactAs "plainIfShort" .

# --- telemetry events ---

gle:ev-admit-start a gle:TelemetryEvent ;
    gle:name "graphlaw_ex.admit.start" ;
    gle:description "An admit call began." ;
    gle:logLevel "debug" ;
    gle:emittedBy gle:mod-Telemetry ;
    gle:measurement "system_time" ;
    gle:metadataKey gle:mk-op, gle:mk-server, gle:mk-source-digest .

gle:ev-admit-stop a gle:TelemetryEvent ;
    gle:name "graphlaw_ex.admit.stop" ;
    gle:description "An admit call returned (ok or refused)." ;
    gle:logLevel "info" ;
    gle:emittedBy gle:mod-Telemetry ;
    gle:measurement "duration" ;
    gle:metadataKey gle:mk-op, gle:mk-server, gle:mk-source-digest, gle:mk-outcome, gle:mk-refusal-code .

gle:ev-admit-exception a gle:TelemetryEvent ;
    gle:name "graphlaw_ex.admit.exception" ;
    gle:description "An admit call raised, exited or threw; re-raised after the event." ;
    gle:logLevel "warning" ;
    gle:emittedBy gle:mod-Telemetry ;
    gle:measurement "duration" ;
    gle:metadataKey gle:mk-op, gle:mk-server, gle:mk-source-digest, gle:mk-outcome, gle:mk-refusal-code, gle:mk-kind, gle:mk-reason, gle:mk-stacktrace .

gle:ev-engine-admit a gle:TelemetryEvent ;
    gle:name "graphlaw_ex.engine.admit" ;
    gle:description "The wasm engine load receipt." ;
    gle:logLevel "debug" ;
    gle:emittedBy gle:mod-EngineLoad ;
    gle:metadataKey gle:mk-outcome, gle:mk-code, gle:mk-wasm-sha256 .

gle:ev-host-call-stop a gle:TelemetryEvent ;
    gle:name "graphlaw_ex.host.call.stop" ;
    gle:description "A host call into the wasm instance finished." ;
    gle:logLevel "debug" ;
    gle:emittedBy gle:mod-Host ;
    gle:measurement "duration" ;
    gle:metadataKey gle:mk-op, gle:mk-outcome, gle:mk-code .

gle:ev-host-recycle a gle:TelemetryEvent ;
    gle:name "graphlaw_ex.host.recycle" ;
    gle:description "The wasm instance was recycled." ;
    gle:logLevel "debug" ;
    gle:emittedBy gle:mod-Host ;
    gle:measurement "count" ;
    gle:metadataKey gle:mk-reason, gle:mk-wasm-sha256 .

# --- config keys (GraphlawEx.Config / WasmConfig) ---

gle:ck-auto_start a gle:ConfigKey ; gle:keyName "auto_start" ; gle:valueType "boolean" ; gle:default false ; gle:zeroOk false .
gle:ck-wasm_path a gle:ConfigKey ; gle:keyName "wasm_path" ; gle:valueType "nonEmptyString" ; gle:zeroOk false .
gle:ck-pool_size a gle:ConfigKey ; gle:keyName "pool_size" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; rdfs:comment "Listed in Config.keys/0; Pool size is passed as size: n, default System.schedulers_online/0." .
gle:ck-fuel a gle:ConfigKey ; gle:keyName "fuel" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:defaultExpr "timeout_ms * fuel_per_ms" .
gle:ck-timeout_ms a gle:ConfigKey ; gle:keyName "timeout_ms" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:default 5000 .
gle:ck-fuel_per_ms a gle:ConfigKey ; gle:keyName "fuel_per_ms" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:default 1000000 .
gle:ck-instantiate_fuel a gle:ConfigKey ; gle:keyName "instantiate_fuel" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:default 1000000000 .
gle:ck-memory_limit_bytes a gle:ConfigKey ; gle:keyName "memory_limit_bytes" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:default 268435456 .
gle:ck-recycle_bytes a gle:ConfigKey ; gle:keyName "recycle_bytes" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:default 134217728 .
gle:ck-max_queue a gle:ConfigKey ; gle:keyName "max_queue" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:default 64 .
gle:ck-max_response_bytes a gle:ConfigKey ; gle:keyName "max_response_bytes" ; gle:valueType "posInteger" ; gle:min 1 ; gle:zeroOk false ; gle:default 33554432 .
gle:ck-table_elements a gle:ConfigKey ; gle:keyName "table_elements" ; gle:valueType "nonNegInteger" ; gle:min 0 ; gle:zeroOk true ; gle:default 100000 .
gle:ck-instances a gle:ConfigKey ; gle:keyName "instances" ; gle:valueType "nonNegInteger" ; gle:min 0 ; gle:zeroOk true ; gle:default 10 .
gle:ck-tables a gle:ConfigKey ; gle:keyName "tables" ; gle:valueType "nonNegInteger" ; gle:min 0 ; gle:zeroOk true ; gle:default 10 .
gle:ck-memories a gle:ConfigKey ; gle:keyName "memories" ; gle:valueType "nonNegInteger" ; gle:min 0 ; gle:zeroOk true ; gle:default 4 .

# --- introspection error classes and limit scopes ---

gle:ecm-ResourceLimit a gle:ErrorClassMap ; gle:refusalKind "ResourceLimit" ; gle:errorClass "forbidden" .
gle:ecm-NotSemanticContent a gle:ErrorClassMap ; gle:refusalKind "NotSemanticContent" ; gle:errorClass "invalid" .
gle:ecm-Ambiguous a gle:ErrorClassMap ; gle:refusalKind "Ambiguous" ; gle:errorClass "invalid" .
gle:ecm-EngineRejected a gle:ErrorClassMap ; gle:refusalKind "EngineRejected" ; gle:errorClass "invalid" .
gle:ecm-Unsupported a gle:ErrorClassMap ; gle:refusalKind "Unsupported" ; gle:errorClass "unknown" .
gle:ecm-TierMismatch a gle:ErrorClassMap ; gle:refusalKind "TierMismatch" ; gle:errorClass "forbidden" .
gle:ecm-DuckDb a gle:ErrorClassMap ; gle:refusalKind "DuckDb" ; gle:errorClass "invalid" .
gle:ecm-BareSql a gle:ErrorClassMap ; gle:refusalKind "BareSql" ; gle:errorClass "invalid" .
gle:ecm-Fuse a gle:ErrorClassMap ; gle:refusalKind "Fuse" ; gle:errorClass "forbidden" .
gle:ecm-other a gle:ErrorClassMap ; gle:refusalKind "*" ; gle:errorClass "unknown" ; rdfs:comment "Any kind not listed above." .
gle:ls-n3 a gle:LimitScope ; gle:limitPrefix "n3_" ; gle:scopedToOp gle:op-n3 .
gle:ls-hooks a gle:LimitScope ; gle:limitPrefix "hooks_" ; gle:scopedToOp gle:op-hooks .
gle:ls-law a gle:LimitScope ; gle:limitPrefix "max_plan_" ; gle:scopedToOp gle:op-law .
gle:ls-policy a gle:LimitScope ; gle:limitPrefix "max_policy_" ; gle:scopedToOp gle:op-policy .

# --- registry ops ---

gle:op-canonical a gle:Op ; gle:opName "canonical" .
gle:op-capabilities a gle:Op ; gle:opName "capabilities" .
gle:op-convert a gle:Op ; gle:opName "convert" .
gle:op-datalog a gle:Op ; gle:opName "datalog" .
gle:op-entail a gle:Op ; gle:opName "entail" .
gle:op-hooks a gle:Op ; gle:opName "hooks" .
gle:op-law a gle:Op ; gle:opName "law" .
gle:op-n3 a gle:Op ; gle:opName "n3" .
gle:op-parse a gle:Op ; gle:opName "parse" .
gle:op-policy a gle:Op ; gle:opName "policy" .
gle:op-shacl a gle:Op ; gle:opName "shacl" .
gle:op-shex a gle:Op ; gle:opName "shex" .
gle:op-sniff a gle:Op ; gle:opName "sniff" .
gle:op-sparql a gle:Op ; gle:opName "sparql" .

# --- op examples (projection of registry/op-examples.json) ---

gle:ex-capabilities-default a gle:OpExample ; gle:exampleId "capabilities.default" ; gle:forOp gle:op-capabilities ; gle:description "Report ABI version, authorities and the supported op and dialect surface." ; gle:outcome "ok" ; gle:requestJson "{\"op\":\"capabilities\"}" ; gle:positiveControl true .
gle:ex-sniff-turtle a gle:OpExample ; gle:exampleId "sniff.turtle" ; gle:forOp gle:op-sniff ; gle:description "Content routing recognises Turtle." ; gle:outcome "ok" ; gle:requestJson "{\"op\":\"sniff\",\"text\":\"@prefix e: <https://e/> . e:s e:p e:o .\"}" ; gle:positiveControl true .
gle:ex-sniff-ntriples a gle:OpExample ; gle:exampleId "sniff.ntriples" ; gle:forOp gle:op-sniff ; gle:description "Content routing recognises N-Triples." ; gle:outcome "ok" ; gle:requestJson "{\"op\":\"sniff\",\"text\":\"<https://e/s> <https://e/p> <https://e/o> .\\n\"}" ; gle:positiveControl false .
gle:ex-sniff-n3-hint a gle:OpExample ; gle:exampleId "sniff.n3-hint" ; gle:forOp gle:op-sniff ; gle:description "A hint steers routing toward N3 rules." ; gle:outcome "ok" ; gle:requestJson "{\"hint\":\"n3\",\"op\":\"sniff\",\"text\":\"{ ?x a <https://e/A> } => { ?x a <https://e/B> } .\"}" ; gle:positiveControl false .
gle:ex-sniff-sparql a gle:OpExample ; gle:exampleId "sniff.sparql" ; gle:forOp gle:op-sniff ; gle:description "Content routing recognises a SPARQL query." ; gle:outcome "ok" ; gle:requestJson "{\"op\":\"sniff\",\"text\":\"SELECT * WHERE { ?s ?p ?o }\"}" ; gle:positiveControl false .
gle:ex-sniff-html-refused a gle:OpExample ; gle:exampleId "sniff.html-refused" ; gle:forOp gle:op-sniff ; gle:description "HTML is not semantic content." ; gle:outcome "refused" ; gle:refusalKind "NotSemanticContent" ; gle:requestJson "{\"op\":\"sniff\",\"text\":\"<!DOCTYPE html><html></html>\"}" ; gle:positiveControl false .
gle:ex-sniff-missing-text-refused a gle:OpExample ; gle:exampleId "sniff.missing-text-refused" ; gle:forOp gle:op-sniff ; gle:description "A request without text is refused as unsupported." ; gle:outcome "refused" ; gle:refusalKind "Unsupported" ; gle:requestJson "{\"op\":\"sniff\"}" ; gle:positiveControl false .
gle:ex-parse-turtle a gle:OpExample ; gle:exampleId "parse.turtle" ; gle:forOp gle:op-parse ; gle:description "Parse Turtle and report the quad count and dataset id." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"parse\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\"}" ; gle:positiveControl true .
gle:ex-parse-sniffed a gle:OpExample ; gle:exampleId "parse.sniffed" ; gle:forOp gle:op-parse ; gle:description "Parse without a dialect: the router sniffs Turtle." ; gle:outcome "ok" ; gle:requestJson "{\"op\":\"parse\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\"}" ; gle:positiveControl false .
gle:ex-parse-n3-syntax-check a gle:OpExample ; gle:exampleId "parse.n3-syntax-check" ; gle:forOp gle:op-parse ; gle:description "A non-RDF dialect (N3) is syntax-checked and reports valid." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"n3\",\"op\":\"parse\",\"text\":\"{ ?x a <https://e/A> } => { ?x a <https://e/B> } .\"}" ; gle:positiveControl false .
gle:ex-parse-turtle-invalid-refused a gle:OpExample ; gle:exampleId "parse.turtle-invalid-refused" ; gle:forOp gle:op-parse ; gle:description "Malformed Turtle is rejected by the engine." ; gle:outcome "refused" ; gle:refusalKind "EngineRejected" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"parse\",\"text\":\"<a> <b> .\"}" ; gle:positiveControl false .
gle:ex-parse-unknown-dialect-refused a gle:OpExample ; gle:exampleId "parse.unknown-dialect-refused" ; gle:forOp gle:op-parse ; gle:description "An unknown dialect name is unsupported." ; gle:outcome "refused" ; gle:refusalKind "Unsupported" ; gle:requestJson "{\"dialect\":\"nope\",\"op\":\"parse\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\"}" ; gle:positiveControl false .
gle:ex-convert-turtle a gle:OpExample ; gle:exampleId "convert.turtle" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to turtle." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"turtle\"}" ; gle:positiveControl true .
gle:ex-convert-trig a gle:OpExample ; gle:exampleId "convert.trig" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to trig." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"trig\"}" ; gle:positiveControl false .
gle:ex-convert-ntriples a gle:OpExample ; gle:exampleId "convert.ntriples" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to ntriples." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"ntriples\"}" ; gle:positiveControl false .
gle:ex-convert-nquads a gle:OpExample ; gle:exampleId "convert.nquads" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to nquads." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"nquads\"}" ; gle:positiveControl false .
gle:ex-convert-rdfxml a gle:OpExample ; gle:exampleId "convert.rdfxml" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to rdfxml." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"rdfxml\"}" ; gle:positiveControl false .
gle:ex-convert-jsonld a gle:OpExample ; gle:exampleId "convert.jsonld" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to jsonld." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"jsonld\"}" ; gle:positiveControl false .
gle:ex-convert-yamlld a gle:OpExample ; gle:exampleId "convert.yamlld" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to yamlld." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"yamlld\"}" ; gle:positiveControl false .
gle:ex-convert-trix a gle:OpExample ; gle:exampleId "convert.trix" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to trix." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"trix\"}" ; gle:positiveControl false .
gle:ex-convert-hextuples a gle:OpExample ; gle:exampleId "convert.hextuples" ; gle:forOp gle:op-convert ; gle:description "Convert the sample graph to hextuples." ; gle:outcome "ok" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"hextuples\"}" ; gle:positiveControl false .
gle:ex-convert-non-rdf-target-refused a gle:OpExample ; gle:exampleId "convert.non-rdf-target-refused" ; gle:forOp gle:op-convert ; gle:description "A non-RDF target dialect is unsupported." ; gle:outcome "refused" ; gle:refusalKind "Unsupported" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"to\":\"n3\"}" ; gle:positiveControl false .
gle:ex-convert-bad-source-refused a gle:OpExample ; gle:exampleId "convert.bad-source-refused" ; gle:forOp gle:op-convert ; gle:description "Malformed source text is rejected." ; gle:outcome "refused" ; gle:refusalKind "EngineRejected" ; gle:requestJson "{\"dialect\":\"turtle\",\"op\":\"convert\",\"text\":\"<a> <b> .\",\"to\":\"ntriples\"}" ; gle:positiveControl false .
gle:ex-canonical-flat a gle:OpExample ; gle:exampleId "canonical.flat" ; gle:forOp gle:op-canonical ; gle:description "Canonical N-Quads and id for the sample graph." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\"},\"op\":\"canonical\"}" ; gle:positiveControl true .
gle:ex-canonical-nested-data-spec a gle:OpExample ; gle:exampleId "canonical.nested-data-spec" ; gle:forOp gle:op-canonical ; gle:description "A data spec with hint and base canonicalises to the same content." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"base\":\"https://e/\",\"dialect\":\"turtle\",\"hint\":\"ttl\",\"text\":\"<s> <p> <o> .\"},\"op\":\"canonical\"}" ; gle:positiveControl false .
gle:ex-canonical-string-data-refused a gle:OpExample ; gle:exampleId "canonical.string-data-refused" ; gle:forOp gle:op-canonical ; gle:description "A bare string is not a data spec object." ; gle:outcome "refused" ; gle:refusalKind "Unsupported" ; gle:requestJson "{\"data\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\",\"op\":\"canonical\"}" ; gle:positiveControl false .
gle:ex-sparql-select a gle:OpExample ; gle:exampleId "sparql.select" ; gle:forOp gle:op-sparql ; gle:description "SELECT returns solutions." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\"},\"op\":\"sparql\",\"query\":\"SELECT ?o WHERE { <https://e/s> <https://e/p> ?o } ORDER BY ?o\"}" ; gle:positiveControl true .
gle:ex-sparql-construct a gle:OpExample ; gle:exampleId "sparql.construct" ; gle:forOp gle:op-sparql ; gle:description "CONSTRUCT returns a graph." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\"},\"op\":\"sparql\",\"query\":\"CONSTRUCT { ?s a <https://e/U> } WHERE { ?s a <https://e/T> }\"}" ; gle:positiveControl false .
gle:ex-sparql-ask a gle:OpExample ; gle:exampleId "sparql.ask" ; gle:forOp gle:op-sparql ; gle:description "ASK returns a boolean." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:s ex:p ex:o, \\\"caf\\\\u00e9\\\"@fr, 42 ; a ex:T .\"},\"op\":\"sparql\",\"query\":\"ASK { <https://e/s> a <https://e/T> }\"}" ; gle:positiveControl false .
