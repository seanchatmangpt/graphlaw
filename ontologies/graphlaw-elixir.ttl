gle:ex-law-shacl-n3 a gle:OpExample ; gle:exampleId "law.shacl-n3" ; gle:forOp gle:op-law ; gle:description "Derive with N3 then admit with SHACL; receipts are chained." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:a a ex:T ; ex:name \\\"a\\\" .\"},\"op\":\"law\",\"steps\":[{\"rules\":\"@prefix ex: <https://e/> . { ?x a ex:T } => { ?x a ex:Checked } .\",\"step\":\"n3\"},{\"shapes\":\"@prefix sh: <http://www.w3.org/ns/shacl#> . @prefix ex: <https://e/> .\\nex:S a sh:NodeShape ; sh:targetClass ex:T ; sh:property [ sh:path ex:name ; sh:minCount 1 ] .\",\"step\":\"shacl\"}]}" ; gle:positiveControl true .
gle:ex-law-rdfs a gle:OpExample ; gle:exampleId "law.rdfs" ; gle:forOp gle:op-law ; gle:description "An RDFS entailment step is receipted." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"ntriples\",\"text\":\"<urn:a:C> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <urn:a:D> .\\n<urn:a:x> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:a:C> .\\n\"},\"op\":\"law\",\"steps\":[{\"step\":\"rdfs\"}]}" ; gle:positiveControl false .
gle:ex-law-owl-rl a gle:OpExample ; gle:exampleId "law.owl-rl" ; gle:forOp gle:op-law ; gle:description "An OWL-RL entailment step is receipted." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"ntriples\",\"text\":\"<urn:a:C> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <urn:a:D> .\\n<urn:a:x> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:a:C> .\\n\"},\"op\":\"law\",\"steps\":[{\"step\":\"owl-rl\"}]}" ; gle:positiveControl false .
gle:ex-law-plan-receipts a gle:OpExample ; gle:exampleId "law.plan-receipts" ; gle:forOp gle:op-law ; gle:description "A two-action plan is admitted, its receipts recorded and required." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"ntriples\",\"text\":\"<urn:p:robot> <urn:p:at> <urn:p:a> .\\n\"},\"op\":\"law\",\"steps\":[{\"plan\":{\"actions\":[{\"add\":\"<urn:p:robot> <urn:p:at> <urn:p:b> .\\n\",\"del\":\"<urn:p:robot> <urn:p:at> <urn:p:a> .\\n\",\"name\":\"a-b\",\"pre\":\"<urn:p:robot> <urn:p:at> <urn:p:a> .\\n\"},{\"add\":\"<urn:p:robot> <urn:p:at> <urn:p:c> .\\n\",\"del\":\"<urn:p:robot> <urn:p:at> <urn:p:b> .\\n\",\"name\":\"b-c\",\"pre\":\"<urn:p:robot> <urn:p:at> <urn:p:b> .\\n\"}],\"goal\":\"<urn:p:robot> <urn:p:at> <urn:p:c> .\\n\"},\"step\":\"plan\"},{\"step\":\"record-receipts\"},{\"step\":\"require-receipt\",\"step_name\":\"plan-action\"}]}" ; gle:positiveControl false .
gle:ex-law-hooks-step a gle:OpExample ; gle:exampleId "law.hooks-step" ; gle:forOp gle:op-law ; gle:description "A hooks step runs an inline kh pack." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:x a ex:A .\"},\"op\":\"law\",\"steps\":[{\"pack\":{\"dialect\":\"turtle\",\"text\":\"@prefix kh: <http://seanchatmangpt.github.io/graphlaw/kh#> . @prefix ex: <https://e/> .\\nex:h a kh:Hook ; kh:kind \\\"sparql\\\" ; kh:effect \\\"emit-delta\\\" ; kh:action ex:a ;\\n  kh:query \\\"SELECT ?x WHERE { ?x a <https://e/A> }\\\" .\\nex:a a kh:Action ; kh:handler <http://seanchatmangpt.github.io/graphlaw/handler#sparql-construct> ;\\n  kh:query \\\"CONSTRUCT { ?x a <https://e/B> } WHERE { ?x a <https://e/A> }\\\" .\\n\"},\"step\":\"hooks\"}]}" ; gle:positiveControl false .
gle:ex-law-leased-shacl-n3-plan a gle:OpExample ; gle:exampleId "law.leased-shacl-n3-plan" ; gle:forOp gle:op-law ; gle:description "shacl, n3 and plan under an unverified lease with an explicit clock." ; gle:outcome "ok" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:a a ex:T ; ex:name \\\"a\\\" .\"},\"lease\":{\"ceiling\":\"construct\",\"expires_unix\":100,\"holder\":\"h\",\"id\":\"L1\",\"scope\":[\"admit:shacl\",\"derive:n3\",\"admit:plan\"]},\"now_unix\":50,\"op\":\"law\",\"steps\":[{\"shapes\":\"@prefix sh: <http://www.w3.org/ns/shacl#> . @prefix ex: <https://e/> .\\nex:S a sh:NodeShape ; sh:targetClass ex:T ; sh:property [ sh:path ex:name ; sh:minCount 1 ] .\",\"step\":\"shacl\"},{\"rules\":\"@prefix ex: <https://e/> . { ?x a ex:T } => { ?x a ex:Checked } .\",\"step\":\"n3\"},{\"plan\":{\"actions\":[{\"add\":\"<https://e/a> <https://e/done> <https://e/yes> .\\n\",\"del\":\"\",\"name\":\"t\",\"pre\":\"<https://e/a> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://e/Checked> .\\n\"}],\"goal\":\"<https://e/a> <https://e/done> <https://e/yes> .\\n\"},\"step\":\"plan\"}],\"unverified_lease\":true}" ; gle:positiveControl false .
gle:ex-law-shacl-not-admitted-refused a gle:OpExample ; gle:exampleId "law.shacl-not-admitted-refused" ; gle:forOp gle:op-law ; gle:description "SHACL admission refuses violating data." ; gle:outcome "refused" ; gle:refusalKind "EngineRejected" ; gle:refusalCode "NotAdmitted" ; gle:requestJson "{\"data\":{\"dialect\":\"turtle\",\"text\":\"@prefix ex: <https://e/> . ex:a a ex:T .\"},\"op\":\"law\",\"steps\":[{\"shapes\":\"@prefix sh: <http://www.w3.org/ns/shacl#> . @prefix ex: <https://e/> .\\nex:S a sh:NodeShape ; sh:targetClass ex:T ; sh:property [ sh:path ex:name ; sh:minCount 1 ] .\",\"step\":\"shacl\"}]}" ; gle:positiveControl false .
