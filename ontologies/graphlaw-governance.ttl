    rdfs:comment "SQL-in-RDF executes caller-supplied statements: never lease-less." .
# Op 15 is dispatched in src/abi.rs but hidden from the 14-op registry table
# (registry::HIDDEN_OPS) so surface_blake3 is stable. The `sql` op above is the
# SQL-in-RDF dialect floor; `duckdb` is the wire op name of op-15.
gl:op-duckdb a gl:OpFloor ; gl:opName "duckdb" ; gl:abiOpNumber 15 ; gl:floor gl:ceiling-construct ; gl:hidden true ;
    gl:hiddenReason "unadvertised from capabilities.ops by digest-stability choice; not host-only and not REFUSAL-04" .

