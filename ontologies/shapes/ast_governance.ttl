@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sql:  <http://graphlaw.org/sql#> .

<http://graphlaw.org/shapes/ast-governance>
    a owl:Ontology ;
    rdfs:label "GraphLaw SQL-AST Governance Shapes" ;
    rdfs:comment "Phase-2 SHACL preflight for the cold-chain case study: anti-scan (a governed SELECT/UPDATE/DELETE must carry a WHERE constraint), and identifier pattern invariants (anti-injection) on table names. Property shapes carry IRIs so violation reports name the violated constraint addressably." ;
    owl:versionInfo "1.0.0" .

# =============================================================================
# sql:SelectStatementShape — anti-scan + structural invariants
# =============================================================================

sql:SelectStatementShape a sh:NodeShape ;
    rdfs:label "Governed SELECT statement shape" ;
    sh:targetClass sql:SelectStatement ;
    sh:node sql:HasFromTable ;
    sh:property sql:FromTableNamePattern ;
    sh:property sql:JoinTableNamePattern ;
    sh:node sql:HasSelectList ;
    # Anti-scan law: every governed SELECT must be bounded by an explicit
    # predicate — an unbounded WHERE-less scan is refused at preflight,
    # before any pushdown to the columnar engine.
    sh:node sql:HasWhereClause .

# Disjunction (alias window): a governed SELECT carries its FROM source in
# exactly one of the two legal spellings — legacy sql:fromTable (one
# well-formed TableRef) or normative sql:from (one ordered list, rec section
# 4). Without the sh:or, a purely normative document would fail governance
# while passing sql-ast.ttl (conjoin contradiction, L55 finding A).
# NodeShape (not PropertyShape): SHACL requires a direct sh:path on a
# PropertyShape; the disjunction branches each carry their own path.
sql:HasFromTable a sh:NodeShape ;
    sh:or (
        [ sh:path sql:fromTable ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:node sql:TableRefShape ; ]
        [ sh:path sql:from ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:node sql:OrderedListShape ; ]
    ) .

# Identifier pattern on table names, evaluated through sequence property
# paths so the Pattern violation is reported directly at the governed query
# node (sh:node folds nested results into NodeConstraintComponent).
sql:FromTableNamePattern a sh:PropertyShape ;
    sh:path ( sql:fromTable sql:tableName ) ;
    sh:datatype xsd:string ;
    sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$" .

sql:JoinTableNamePattern a sh:PropertyShape ;
    sh:path ( sql:joinClause sql:joinTable sql:tableName ) ;
    sh:datatype xsd:string ;
    sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$" .

# Disjunction (alias window): projection list in either spelling — legacy
# sql:selectList or normative sql:select (one ordered list).
sql:HasSelectList a sh:NodeShape ;
    sh:or (
        [ sh:path sql:selectList ;
          sh:minCount 1 ;
          sh:maxCount 1 ; ]
        [ sh:path sql:select ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:node sql:OrderedListShape ; ]
    ) .

# Anti-scan law: a governed SELECT without a WHERE clause is an unbounded
# scan and is refused at preflight. The sh:or keeps the law binding across
# both spellings (legacy sql:whereClause / normative sql:where) so the
# targetClass sql:SelectStatement scope still covers every SELECT.
sql:HasWhereClause a sh:NodeShape ;
    sh:or (
        [ sh:path sql:whereClause ;
          sh:minCount 1 ; ]
        [ sh:path sql:where ;
          sh:minCount 1 ; ]
    ) .

# =============================================================================
# sql:UpdateStatementShape / sql:DeleteStatementShape — anti-scan on mutation
# =============================================================================

sql:UpdateStatementShape a sh:NodeShape ;
    rdfs:label "Governed UPDATE statement shape" ;
    sh:targetClass sql:UpdateStatement ;
    # Anti-scan law: unbounded UPDATE/DELETE is a refusal at admission,
    # never an engine-side no-op — every governed UPDATE must carry a WHERE
    # constraint in at least one legal spelling.
    sh:node sql:HasWhereConstraint .

sql:DeleteStatementShape a sh:NodeShape ;
    rdfs:label "Governed DELETE statement shape" ;
    sh:targetClass sql:DeleteStatement ;
    # Anti-scan law: unbounded UPDATE/DELETE is a refusal at admission,
    # never an engine-side no-op — every governed DELETE must carry a WHERE
    # constraint in at least one legal spelling.
    sh:node sql:HasWhereConstraint .

# Disjunction (alias window): a governed UPDATE or DELETE carries its WHERE
# constraint in at least one of the four legal spellings — legacy
# sql:whereClause, normative sql:where, or the column/value constraint pair
# sql:whereColumn / sql:whereValue. At least one branch must be present
# (minCount 1 on at least one); without the sh:or, a purely legacy or purely
# column/value-constrained document would fail governance while passing
# sql-ast.ttl.
sql:HasWhereConstraint a sh:NodeShape ;
    sh:or (
        [ sh:path sql:whereClause ;
          sh:minCount 1 ; ]
        [ sh:path sql:where ;
          sh:minCount 1 ; ]
        [ sh:path sql:whereColumn ;
          sh:minCount 1 ; ]
        [ sh:path sql:whereValue ;
          sh:minCount 1 ; ]
    ) .

# =============================================================================
# sql:TableRefShape — identifier pattern (anti-injection)
# =============================================================================

sql:TableRefShape a sh:NodeShape ;
    rdfs:label "Governed table reference (FROM and JOIN table refs)" ;
    sh:targetClass sql:TableRef ;
    sh:property sql:TableNamePattern .

sql:TableNamePattern a sh:PropertyShape ;
    sh:path sql:tableName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$" .
