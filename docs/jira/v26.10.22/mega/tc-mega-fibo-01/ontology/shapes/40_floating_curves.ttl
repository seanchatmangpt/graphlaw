### 4. Floating-curve enum (SOFR/SONIA/EURIBOR)
reg:FloatingCurveShape a sh:NodeShape ;
    sh:targetClass reg:FloatingRateLeg ;
    sh:property [
        sh:path reg:floatingCurve ;
        sh:in ( "SOFR" "SONIA" "EURIBOR" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "floating curve must be one of SOFR/SONIA/EURIBOR (closed enum)" ;
    ] ;
    sh:property [
        sh:path reg:resetFrequency ;
        sh:datatype xsd:string ;
        sh:pattern "^(DAILY|WEEKLY|MONTHLY|QUARTERLY)$" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

reg:Curve_SOFR_Shape a sh:NodeShape ;
    sh:targetClass reg:FloatingRateLeg ;
    sh:property [ sh:path reg:floatingCurve ; sh:hasValue "SOFR" ] .

reg:Curve_SONIA_Shape a sh:NodeShape ;
    sh:targetClass reg:FloatingRateLeg ;
    sh:property [ sh:path reg:floatingCurve ; sh:hasValue "SONIA" ] .

reg:Curve_EURIBOR_Shape a sh:NodeShape ;
    sh:targetClass reg:FloatingRateLeg ;
    sh:property [ sh:path reg:floatingCurve ; sh:hasValue "EURIBOR" ] .

