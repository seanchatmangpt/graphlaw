### 1. Jurisdiction enum (closed world: US/UK/EU) + CCP membership
reg:JurisdictionShape a sh:NodeShape ;
    sh:targetClass reg:RegulatedParty ;
    sh:property [
        sh:path reg:jurisdiction ;
        sh:in ( "US" "UK" "EU" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "jurisdiction must be exactly one of US/UK/EU (closed enum)" ;
    ] .

reg:CCPMembershipShape a sh:NodeShape ;
    sh:targetClass reg:ClearingMemberParty ;
    sh:property [
        sh:path reg:ccpMemberOf ;
        sh:node reg:CCPNodeShape ;
        sh:minCount 1 ;
        sh:message "a clearing member must reference a well-formed CCP" ;
    ] .

reg:CCPNodeShape a sh:NodeShape ;
    sh:targetClass reg:CentralCounterparty ;
    sh:property [
        sh:path reg:ccpId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path reg:jurisdiction ;
        sh:in ( "US" "UK" "EU" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
reg:CCPMembership_USShape a sh:NodeShape ;
    sh:targetClass reg:ClearingMemberParty ;
    sh:property [
        sh:path reg:ccpMemberOf ;
        sh:qualifiedValueShape [ sh:path reg:jurisdiction ; sh:hasValue "US" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "US/EU/UK clearing members must point at a US-domiciled CCP" ;
    ] .

reg:CCPMembership_UKShape a sh:NodeShape ;
    sh:targetClass reg:ClearingMemberParty ;
    sh:property [
        sh:path reg:ccpMemberOf ;
        sh:qualifiedValueShape [ sh:path reg:jurisdiction ; sh:hasValue "UK" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "US/EU/UK clearing members must point at a UK-domiciled CCP" ;
    ] .

reg:CCPMembership_EUShape a sh:NodeShape ;
    sh:targetClass reg:ClearingMemberParty ;
    sh:property [
        sh:path reg:ccpMemberOf ;
        sh:qualifiedValueShape [ sh:path reg:jurisdiction ; sh:hasValue "EU" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "US/EU/UK clearing members must point at a EU-domiciled CCP" ;
    ] .

