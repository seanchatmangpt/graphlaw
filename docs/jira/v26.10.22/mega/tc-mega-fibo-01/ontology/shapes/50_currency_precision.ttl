@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix reg: <http://graphlaw.org/ns/mega/fibo/reg#> .

### 5. Currency decimal-precision shapes (parametric over 26 currencies)
# NOTE: the #41209 mutation twin violates the USD precision pattern in
# shapes/51_precision_anchor_41209.ttl. The per-currency shapes here carry the
# same closed-world pattern family at full scale.
reg:MoneyPrecision_USD a sh:NodeShape ;
    sh:targetClass reg:MoneyAmount_USD ;
    sh:property [
        sh:path reg:amount ;
        sh:datatype xsd:decimal ;
        sh:pattern "^[+-]?\\d+(\\.\\d{1,2})?$" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "USD amounts carry at most 2 decimal place(s) (ISO 4217 minor units)" ;
    ] .

