# sql-rdf statement: USD tear-up exposure from the cleared book
tcg:stmt-usd-exposure a sql:SelectStatement ;
    sql:statementIndex "0"^^xsd:integer ;
    sql:selectList (
        [ sql:columnName "jurisdiction" ]
        [ sql:valueExpression "COUNT(*)" ]
    ) ;
    sql:fromTable "tcg_derivative_legs" ;
    sql:whereClause [
        sql:operator sql:Equals ;
        sql:leftOperand [ sql:columnName "currency" ] ;
        sql:rightOperand [ sql:literalValue "USD" ]
    ] ;
    sql:limit "100"^^xsd:integer .
