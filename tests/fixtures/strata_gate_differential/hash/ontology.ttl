# strata-hash-pack ontology — Strata S1 crypto primitives: hash algorithms,
# digests, and Merkle vocabulary on the family kernel namespace.

@prefix st:  <https://strata.chatman.ai/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Classes ──────────────────────────────────────────────────────────

st:HashAlgorithm a rdfs:Class ; rdfs:label "HashAlgorithm" ;
    rdfs:comment "A concrete cryptographic hash function (e.g. BLAKE3, SHA-256) with a fixed digest output length." .

st:Digest a rdfs:Class ; rdfs:label "Digest" ;
    rdfs:comment "The fixed-length output of a HashAlgorithm; every digest this family uses is 32 bytes." .

st:MerkleNode a rdfs:Class ; rdfs:label "MerkleNode" ;
    rdfs:comment "A node in a Merkle tree: a leaf (hash of a data chunk) or an internal node (hash of child concat, odd child duplicated per the Bitcoin duplication rule)." .

st:MerkleTree a rdfs:Class ; rdfs:label "MerkleTree" ;
    rdfs:comment "A binary hash tree over an ordered leaf vector; carries a 32-byte root and per-leaf inclusion proofs." .

# ── Properties ───────────────────────────────────────────────────────

st:algorithmName a rdf:Property ; rdfs:label "algorithm name" ;
    rdfs:comment "Rust identifier of the algorithm (const/projection name)." ;
    rdfs:domain st:HashAlgorithm ; rdfs:range xsd:string .

st:digestLength a rdf:Property ; rdfs:label "digest length" ;
    rdfs:comment "Digest output length in bytes." ;
    rdfs:domain st:Digest ; rdfs:range xsd:integer .

st:merkleRule a rdf:Property ; rdfs:label "merkle rule" ;
    rdfs:comment "Internal-node rule for MerkleNode. Fixed to 'duplicate-last' (odd child hashed with itself, the Bitcoin duplication rule): H(a,b) = H(a || a) when a == last at odd level width." ;
    rdfs:domain st:MerkleNode ; rdfs:range xsd:string .

st:merkleRoot a rdf:Property ; rdfs:label "merkle root" ;
    rdfs:comment "The 32-byte root digest of a MerkleTree." ;
    rdfs:domain st:MerkleTree ; rdfs:range xsd:hexBinary .

# ── Individuals ──────────────────────────────────────────────────────
# Ground truth for output lengths: BLAKE3 is defined with a 256-bit (32-byte)
# default output per the BLAKE3 paper (O'Connor, Aumasson, Neves, Wilcox-O
# Hearn, "BLAKE3: one function, fast everywhere", 2020); SHA-256 produces a
# 256-bit digest per FIPS 180-4 section 6.2. No fabricated citations beyond
# these primary specs.

st:BLAKE3 a st:HashAlgorithm ;
    rdfs:label "BLAKE3" ;
    rdfs:seeAlso <https://github.com/BLAKE3-team/BLAKE3-specs> ;
    st:algorithmName "BLAKE3" ;
    st:digestLength 32 .

st:SHA_256 a st:HashAlgorithm ;
    rdfs:label "SHA-256" ;
    rdfs:seeAlso <https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf> ;
    st:algorithmName "SHA_256" ;
    st:digestLength 32 .

# The 32-byte digest both algorithms share (the family digest width).
st:digest32 a st:Digest ;
    rdfs:label "Digest32" ;
    st:digestLength 32 ;
    rdfs:comment "The family digest width: both supported algorithms output 32 bytes (BLAKE3 default 256-bit output; FIPS 180-4 §6.2 SHA-256)." .

# ── Merkle vocabulary (naming only; implementation lives in the generated
#    module) ───────────────────────────────────────────────────────────

st:merkle_rule_duplicate_last a st:MerkleNode ;
    st:merkleRule "duplicate-last" ;
    rdfs:comment "Odd-width level: the last node is hashed with itself, matching the Bitcoin duplication rule." .

# ── praxis-chain/v2-fold receipt chain law (L51 seam 1, rank 1) ──────
# Spec provenance: /Users/sac/graphlaw/src/receipt_chain.rs —
# build_admission_frame (blake3 fold of payload_hash || meta_json, mixed
# into 8 PackedObjRef slots as little-endian u32 words),
# OcelCausalFrame::to_hash_bytes (99-byte frame body layout),
# OcelCausalReceipt::chain (chain_hash(t+1) = BLAKE3(chain_hash(t) ||
# frame_bytes(t+1))), and fold_in_v2_epoch (BLAKE3 over base || schema ||
# epoch bytes; strict no-op when the v2 payload is absent). Discriminator
# CHAIN_RULE_V2_FOLD = "praxis-chain/v2-fold" (receipt_chain.rs L1315).
# Consumed by ggen-engine receipt_chain_seam.rs (re-export, L49-50) and
# emitted at sync.rs (~L4005) with chain_rule declared on every new v2
# record. KAT court: templates/hash_merkle.rs.tera tests module.

st:ChainRuleV2Fold a rdfs:Class ;
    rdfs:label "ChainRuleV2Fold" ;
    rdfs:comment "Receipt chain rule: base admission-frame chain hash, then the schema string and the full v2 epoch payload folded in by BLAKE3 over base || schema || epoch_bytes. The fold is a strict no-op when v2 is None." .

st:AdmissionFrame a rdfs:Class ;
    rdfs:label "AdmissionFrame" ;
    rdfs:comment "One admission receipt frame: mixed_hash = BLAKE3(payload_hash || meta_json) packed into 8 little-endian u32 obj_refs slots, plus prior_hash = previous chain hash mixed into the 99-byte frame body." .

st:FoldInput a rdfs:Class ;
    rdfs:label "FoldInput" ;
    rdfs:comment "One serialized fold input to the v2-fold law." .

st:foldBase a rdf:Property ; rdfs:label "fold base" ;
    rdfs:comment "The 32-byte base chain hash fed to the fold." ;
    rdfs:domain st:ChainRuleV2Fold ; rdfs:range st:Digest .

st:foldSchema a rdf:Property ; rdfs:label "fold schema" ;
    rdfs:comment "Schema identity string folded in after the base hash (serde_json bytes of the schema, UTF-8)." ;
    rdfs:domain st:ChainRuleV2Fold ; rdfs:range xsd:string .

st:foldEpoch a rdf:Property ; rdfs:label "fold epoch" ;
    rdfs:comment "The full serde_json serialization of the v2 epoch payload, folded in last (compact serde_json::to_vec bytes)." ;
    rdfs:domain st:ChainRuleV2Fold ; rdfs:range st:FoldInput .

st:chainRuleId a rdf:Property ; rdfs:label "chain rule id" ;
    rdfs:comment "Chain-rule discriminator string declared on every newly emitted v2 record." ;
    rdfs:domain st:ChainRuleV2Fold ; rdfs:range xsd:string .

st:chain_rule_v2_fold a st:ChainRuleV2Fold ;
    rdfs:label "praxis-chain/v2-fold" ;
    st:chainRuleId "praxis-chain/v2-fold" ;
    st:foldBase st:digest32 ;
    st:foldSchema "ggen-receipt/v2" ;
    rdfs:comment "The v2-fold law individual: chain_hash(t+1) = BLAKE3(chain_hash(t) || frame_bytes(t+1)) at the base, then BLAKE3(base || schema || epoch_bytes). meta_json = compact serde_json of (andon, object_ids, obligation_count), e.g. [\"Green\",[\"law:<hex16>\"],0]; frame body is 99 bytes: instruction_id:u64le, fired_mask:u64le, denial:u64le, 8x obj_ref:u32le, ts_ns:u64le, activity_idx:u16le, node_kind:u8, prior_hash:32 bytes." .
