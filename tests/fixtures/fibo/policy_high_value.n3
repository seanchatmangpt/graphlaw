# Chicago-court policy (NOT FIBO, NOT a regulation): a MarketTransaction is fin:HighValueTransaction
# when its consideration is worth at least 10_000_000 USD, i.e. >= 10_000_000_000_000 micros
# (inclusive; math:notLessThan). SYNTHETIC subject only; authority NONE; no real payment rail.
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> .
@prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .
@prefix fin: <https://chicago.graphlaw.dev/fin#> .

# R1: USD amount carried in integer micros.
{ ?t tx:consideration ?a . ?a cur:hasCurrency iso:USD . ?a fin:amountMicros ?m .
  ?m math:notLessThan 10000000000000 } => { ?t a fin:HighValueTransaction } .

# R2: USD amount carried as the FIBO decimal (cur:hasAmount); scaled to micros exactly.
{ ?t tx:consideration ?a . ?a cur:hasCurrency iso:USD . ?a cur:hasAmount ?d .
  (?d 1000000) math:product ?p . ?p math:notLessThan 10000000000000 } => { ?t a fin:HighValueTransaction } .

# R3: non-USD amount converts to USD micros only through an ADMITTED exchange rate
# (rateValue = micros of USD per unit of foreign currency; admittedBy must be present).
{ ?t tx:consideration ?a . ?a fin:amountMicros ?m . ?a fin:rateRef ?r .
  ?r fin:admittedBy ?w . ?r fin:rateValue ?rv .
  (?m ?rv) math:product ?p . (?p 1000000) math:integerQuotient ?q .
  ?q math:notLessThan 10000000000000 } => { ?t a fin:HighValueTransaction } .
