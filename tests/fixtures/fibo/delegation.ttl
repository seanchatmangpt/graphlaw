# SYNTHETIC financial subject: no real parties, accounts, or payment rail.
# Standing: finite published corpus passes on exact subject; authority NONE; synthetic subject;
# no general financial safety claim. The USD 10,000,000 threshold is Chicago-court policy, not FIBO's.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> .
@prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> .
@prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .
@prefix fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix stl: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/> .
@prefix fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix fin: <https://chicago.graphlaw.dev/fin#> .
@prefix id: <https://chicago.graphlaw.dev/fin/id#> .

# Delegation of signing authority among synthetic parties. id:party-a -> b -> c -> a is a cycle;
# id:party-d delegates into the cycle; id:party-e delegates to id:party-f (a separate component).
id:party-a fin:delegatesTo id:party-b .
id:party-b fin:delegatesTo id:party-c .
id:party-c fin:delegatesTo id:party-a .
id:party-d fin:delegatesTo id:party-a .
id:party-e fin:delegatesTo id:party-f .

# Delegation is transitive (used by the OWL RL cross-check; the Datalog case restates the edges inline).
fin:delegatesTo a owl:TransitiveProperty .
