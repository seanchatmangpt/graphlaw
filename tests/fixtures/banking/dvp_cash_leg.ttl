# Banking DvP cash leg — bounded UPDATE debit (single root, bare form).
# Compiler law is stricter than the SHACL shape: BOTH sql:whereColumn AND
# sql:whereValue are required on UPDATE (sql_ast.rs compile_command
# UpdateStatement guard; CTQ-4 / REFUSAL-05 unbounded-mutation refusal).
# Expected SQL:
#   UPDATE dvp_cash_ledger SET balance = 95000.00 WHERE account = 'BOOK-A'
@prefix ex: <http://example.org/banking#> .
@prefix sql: <http://graphlaw.org/sql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:stmt1 a sql:UpdateStatement ;
    sql:statementIndex 2 ;
    sql:targetTable "dvp_cash_ledger" ;
    sql:assignColumn "balance" ;
    sql:assignValue "95000.00"^^xsd:decimal ;
    sql:whereColumn "account" ;
    sql:whereValue "BOOK-A" .
