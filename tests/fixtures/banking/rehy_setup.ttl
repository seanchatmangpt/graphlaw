# Rehypothecation collateral setup — sql:StatementSequence document:
# one expression-form CREATE + scalar INSERT members (assignColumn /
# assignValue positional pairing, tc01_insert shape) — the same lifecycle
# the tests/wasm_fibo_fixtures_eh.rs seed pattern runs across separate
# frames, here as one admitted sequence document.
# Expected members:
#   CREATE TABLE rehy_collateral (facility_id VARCHAR, collateral_id VARCHAR, market_value DECIMAL)
#   INSERT INTO rehy_collateral (facility_id, collateral_id, market_value) VALUES ('FAC-101', 'COLL-A', 1000000.00)
#   INSERT INTO rehy_collateral (facility_id, collateral_id, market_value) VALUES ('FAC-101', 'COLL-B', 250000.50)
@prefix ex: <http://example.org/banking#> .
@prefix sql: <http://graphlaw.org/sql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:doc a sql:StatementSequence ;
    sql:statements ( ex:ddl ex:ins1 ex:ins2 ) .

ex:ddl a sql:CreateStatement ;
    sql:statementIndex 0 ;
    sql:tableDefinition [
        sql:tableName "rehy_collateral" ;
        sql:columns (
            [ sql:columnName "facility_id" ; sql:columnType "VARCHAR" ]
            [ sql:columnName "collateral_id" ; sql:columnType "VARCHAR" ]
            [ sql:columnName "market_value" ; sql:columnType "DECIMAL" ]
        ) ;
    ] .

ex:ins1 a sql:InsertStatement ;
    sql:statementIndex 1 ;
    sql:targetTable "rehy_collateral" ;
    sql:assignColumn "facility_id" ;
    sql:assignValue "FAC-101" ;
    sql:assignColumn "collateral_id" ;
    sql:assignValue "COLL-A" ;
    sql:assignColumn "market_value" ;
    sql:assignValue "1000000.00"^^xsd:decimal .

ex:ins2 a sql:InsertStatement ;
    sql:statementIndex 2 ;
    sql:targetTable "rehy_collateral" ;
    sql:assignColumn "facility_id" ;
    sql:assignValue "FAC-101" ;
    sql:assignColumn "collateral_id" ;
    sql:assignValue "COLL-B" ;
    sql:assignColumn "market_value" ;
    sql:assignValue "250000.50"^^xsd:decimal .
