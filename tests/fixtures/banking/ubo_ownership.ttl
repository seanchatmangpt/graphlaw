# UBO ownership chain fixture — sql:StatementSequence document: two
# expression-form CREATEs (owns, ubo_sanctioned) + scalar INSERT members
# (assignColumn / assignValue positional pairing, tc01_insert shape).
# Ownership edges: C->B 60, B->SDN 50, D->E 20, E->F 30.
# Expected members:
#   CREATE TABLE ubo_owns (child VARCHAR, parent VARCHAR, pct DECIMAL)
#   CREATE TABLE ubo_sanctioned (entity VARCHAR)
#   INSERT INTO ubo_owns (child, parent, pct) VALUES ('ENT-C', 'ENT-B', 60)
#   INSERT INTO ubo_owns (child, parent, pct) VALUES ('ENT-B', 'ENT-SDN', 50)
#   INSERT INTO ubo_owns (child, parent, pct) VALUES ('ENT-D', 'ENT-E', 20)
#   INSERT INTO ubo_owns (child, parent, pct) VALUES ('ENT-E', 'ENT-F', 30)
#   INSERT INTO ubo_sanctioned (entity) VALUES ('ENT-SDN')
@prefix ex: <http://example.org/banking#> .
@prefix sql: <http://graphlaw.org/sql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:doc a sql:StatementSequence ;
    sql:statements ( ex:owns_ddl ex:sanc_ddl ex:i1 ex:i2 ex:i3 ex:i4 ex:i5 ) .

ex:owns_ddl a sql:CreateStatement ;
    sql:statementIndex 0 ;
    sql:tableDefinition [
        sql:tableName "ubo_owns" ;
        sql:columns (
            [ sql:columnName "child" ; sql:columnType "VARCHAR" ]
            [ sql:columnName "parent" ; sql:columnType "VARCHAR" ]
            [ sql:columnName "pct" ; sql:columnType "DECIMAL" ]
        ) ;
    ] .

ex:sanc_ddl a sql:CreateStatement ;
    sql:statementIndex 1 ;
    sql:tableDefinition [
        sql:tableName "ubo_sanctioned" ;
        sql:columns (
            [ sql:columnName "entity" ; sql:columnType "VARCHAR" ]
        ) ;
    ] .

ex:i1 a sql:InsertStatement ;
    sql:statementIndex 2 ;
    sql:targetTable "ubo_owns" ;
    sql:assignColumn "child" ; sql:assignValue "ENT-C" ;
    sql:assignColumn "parent" ; sql:assignValue "ENT-B" ;
    sql:assignColumn "pct" ; sql:assignValue "60"^^xsd:decimal .

ex:i2 a sql:InsertStatement ;
    sql:statementIndex 3 ;
    sql:targetTable "ubo_owns" ;
    sql:assignColumn "child" ; sql:assignValue "ENT-B" ;
    sql:assignColumn "parent" ; sql:assignValue "ENT-SDN" ;
    sql:assignColumn "pct" ; sql:assignValue "50"^^xsd:decimal .

ex:i3 a sql:InsertStatement ;
    sql:statementIndex 4 ;
    sql:targetTable "ubo_owns" ;
    sql:assignColumn "child" ; sql:assignValue "ENT-D" ;
    sql:assignColumn "parent" ; sql:assignValue "ENT-E" ;
    sql:assignColumn "pct" ; sql:assignValue "20"^^xsd:decimal .

ex:i4 a sql:InsertStatement ;
    sql:statementIndex 5 ;
    sql:targetTable "ubo_owns" ;
    sql:assignColumn "child" ; sql:assignValue "ENT-E" ;
    sql:assignColumn "parent" ; sql:assignValue "ENT-F" ;
    sql:assignColumn "pct" ; sql:assignValue "30"^^xsd:decimal .

ex:i5 a sql:InsertStatement ;
    sql:statementIndex 6 ;
    sql:targetTable "ubo_sanctioned" ;
    sql:assignColumn "entity" ; sql:assignValue "ENT-SDN" .
