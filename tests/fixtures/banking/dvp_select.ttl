# Banking DvP readback SELECT (bare single-root form, tc05_select_sum shape
# without aggregation). Expected SQL:
#   SELECT account, balance FROM dvp_cash_ledger ORDER BY account
@prefix ex: <http://example.org/banking#> .
@prefix sql: <http://graphlaw.org/sql#> .

ex:stmt1 a sql:SelectStatement ;
    sql:statementIndex 4 ;
    sql:fromTable [ sql:tableName "dvp_cash_ledger" ] ;
    sql:selectList ( [ sql:columnName "account" ] [ sql:columnName "balance" ] ) ;
    sql:orderBy ( [ sql:columnName "account" ] ) .
