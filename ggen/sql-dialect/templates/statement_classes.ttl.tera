# Do not edit by hand.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sql: <http://graphlaw.org/sql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

{% for row in sparql_results %}
sql:{{ row.name }} a owl:Class ;
    rdfs:subClassOf sql:Statement .
{% endfor %}

sql:targetTable a owl:DatatypeProperty ;
    rdfs:range xsd:string .

sql:assignColumn a owl:DatatypeProperty ;
    rdfs:range xsd:string .

sql:assignValue a owl:DatatypeProperty ;
    rdfs:range xsd:string .

sql:whereColumn a owl:DatatypeProperty ;
    rdfs:range xsd:string .

sql:whereValue a owl:DatatypeProperty ;
    rdfs:range xsd:string .

sql:InsertStatementShape a sh:NodeShape ;
    sh:targetClass sql:InsertStatement ;
    sh:property [
        sh:path sql:targetTable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$"
    ] ;
    sh:property [
        sh:path sql:assignColumn ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$"
    ] ;
    sh:property [
        sh:path sql:assignValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

sql:UpdateStatementShape a sh:NodeShape ;
    sh:targetClass sql:UpdateStatement ;
    sh:property [
        sh:path sql:targetTable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$"
    ] ;
    sh:property [
        sh:path sql:assignColumn ;
        sh:minCount 1 ;
        sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$"
    ] .

sql:DeleteStatementShape a sh:NodeShape ;
    sh:targetClass sql:DeleteStatement ;
    sh:property [
        sh:path sql:targetTable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[a-zA-Z_][a-zA-Z0-9_]*$"
    ] .
