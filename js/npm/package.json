{
  "name": "@seanchatmangpt/graphlaw",
  "version": "26.10.28",
  "description": "GraphLaw: library-backed RDF law-state composition (parse, SPARQL, SHACL, ShEx, N3, entailment, datalog, hooks, law, policy) over a WASM ABI",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist-nodejs/",
    "dist-web/",
    "dist-bundler/",
    "wasm/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist-nodejs/index.js",
  "exports": {
    ".": {
      "types": "./dist-nodejs/index.d.ts",
      "node": {
        "import": "./dist-nodejs/index.js"
      },
      "browser": "./dist-web/index.js",
      "default": "./dist-web/index.js"
    },
    "./raw": {
      "types": "./dist-nodejs/raw/index.d.ts",
      "node": {
        "import": "./dist-nodejs/raw/index.js"
      },
      "browser": "./dist-web/raw/index.js",
      "default": "./dist-web/raw/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "build": "npm run gen && node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/assemble.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint:pkg": "publint && attw --pack .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.10.0",
    "playwright-core": "^1.48.0",
    "publint": "^0.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanchatmangpt/graphlaw.git"
  },
  "bugs": "https://github.com/seanchatmangpt/graphlaw/issues",
  "homepage": "https://github.com/seanchatmangpt/graphlaw",
  "keywords": [
    "rdf",
    "n3",
    "sparql",
    "shacl",
    "shex",
    "datalog",
    "ontology",
    "reasoning",
    "wasm",
    "webassembly"
  ],
  "publishConfig": {
    "access": "public"
  }
}
