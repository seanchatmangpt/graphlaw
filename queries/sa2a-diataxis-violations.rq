PREFIX sa2a: <https://seanchatmangpt.github.io/sa2a/diataxis#>
SELECT ?capability ?violation WHERE {
  ?capability a sa2a:Capability .
  {
    FILTER NOT EXISTS { ?capability sa2a:specifiedBy ?contract }
    BIND("missing-reference-contract" AS ?violation)
  } UNION {
    FILTER NOT EXISTS { ?capability sa2a:constrainedBy ?law }
    BIND("missing-law" AS ?violation)
  } UNION {
    FILTER NOT EXISTS { ?capability sa2a:verifiedBy ?gate }
    BIND("missing-verifier" AS ?violation)
  } UNION {
    FILTER NOT EXISTS { ?capability sa2a:repairedBy ?route }
    BIND("missing-repair-route" AS ?violation)
  }
}
ORDER BY ?capability ?violation
