# SA2A executable evidence gate 044
# Canonical contract: contracts/sa2a/refusal/authority-none.ttl
# A true result is evidence only; it grants no authority and performs no DO.
PREFIX sa2a: <https://graphlaw.dev/sa2a#>
PREFIX prov: <http://www.w3.org/ns/prov#>
ASK WHERE {
  <https://graphlaw.dev/sa2a/refusal/authority-none> a sa2a:RefusalEvidence ;
    sa2a:contractVersion ?version ;
    sa2a:canonicalization "RDFC-1.0" ;
    sa2a:authority "NONE" ;
    sa2a:consequence "EVIDENCE_ONLY" ;
    sa2a:requiresExactSubject true ;
    sa2a:requiresSourceDigest true ;
    sa2a:requiresReplayIdentity true ;
    sa2a:rule ?rule ;
    prov:wasAttributedTo <https://graphlaw.dev/sa2a/factory-b> .
  FILTER(STRLEN(STR(?version)) > 0 && STRLEN(STR(?rule)) > 0)
}
