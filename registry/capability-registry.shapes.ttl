@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .
@prefix gls: <https://graphlaw.dev/registry-shapes#> .

# SHACL shapes for registry/capability-registry.ttl (schema graphlaw.capability-registry/1).
# Validated by graphlaw's own `shacl` op (tests/registry_artifacts.rs).

gls: sh:declare [ sh:prefix "gac" ; sh:namespace "http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#"^^xsd:anyURI ] .

gls:RegistryShape a sh:NodeShape ;
    sh:targetClass gac:Registry ;
    sh:property [ sh:path gac:schemaId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "graphlaw.capability-registry/1" ) ] ;
    sh:property [ sh:path gac:graphlawVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:abiVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path gac:surfaceSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
    sh:property [ sh:path gac:registrySha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
    sh:property [ sh:path gac:opCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:dialectCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "exactly one gac:Registry must exist" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { ?other a gac:Registry . FILTER(?other != $this) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:opCount must equal the number of gac:Capability individuals" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this ?n WHERE { $this gac:opCount ?n . ?c a gac:Capability } GROUP BY $this ?n HAVING (COUNT(?c) != ?n)""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:dialectCount must equal the number of gac:Dialect individuals" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this ?n WHERE { $this gac:dialectCount ?n . ?d a gac:Dialect } GROUP BY $this ?n HAVING (COUNT(?d) != ?n)""" ] .

gls:CapabilityShape a sh:NodeShape ;
    sh:targetClass gac:Capability ;
    sh:property [ sh:path gac:capabilityOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class gac:Registry ] ;
    sh:property [ sh:path gac:opName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[a-z][a-z0-9_]*$" ] ;
    sh:property [ sh:path gac:opOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:opSummary ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:opRefusalKind ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:opRefusalCode ; sh:datatype xsd:string ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:opOrder must be unique across capabilities" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:opOrder ?o . ?other gac:opOrder ?o . ?other a gac:Capability . FILTER(?other != $this) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:opName must be unique across capabilities" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:opName ?n . ?other gac:opName ?n . ?other a gac:Capability . FILTER(?other != $this) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "every capability needs at least one gac:ResponseVariant" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this a gac:Capability . FILTER NOT EXISTS { ?v gac:variantOf $this } }""" ] .

gls:ResponseVariantShape a sh:NodeShape ;
    sh:targetClass gac:ResponseVariant ;
    sh:property [ sh:path gac:variantOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class gac:Capability ] ;
    sh:property [ sh:path gac:variantTag ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:variantTagField ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:variantOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:variantTag and gac:variantTagField must both be empty or both be non-empty" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:variantTag ?t ; gac:variantTagField ?f . FILTER((?t = "") != (?f = "")) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "a capability with several response variants must tag every variant" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:variantOf ?c ; gac:variantTag "" . ?other gac:variantOf ?c . FILTER(?other != $this) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:variantOrder must be unique within a capability" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:variantOf ?c ; gac:variantOrder ?o . ?other gac:variantOf ?c ; gac:variantOrder ?o . FILTER(?other != $this) }""" ] .

gls:CapabilityFieldShape a sh:NodeShape ;
    sh:targetClass gac:CapabilityField ;
    sh:property [ sh:path gac:fieldOwner ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path gac:fieldSide ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "request" "response" "detail" "law_step" ) ] ;
    sh:property [ sh:path gac:fieldOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:fieldName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[a-z][a-z0-9_]*$" ] ;
    sh:property [ sh:path gac:fieldType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "string" "integer" "boolean" "object" "any" "data_spec" "term" "json_or_string"
                          "list<string>" "list<object>" "list<any>" "list<term>"
                          "list<list<string>>" "list<list<term>>" ) ] ;
    sh:property [ sh:path gac:fieldRequired ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path gac:fieldNullable ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path gac:fieldDoc ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:fieldDefault ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:fieldOrder must be unique within an owner and side" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:fieldOwner ?w ; gac:fieldSide ?s ; gac:fieldOrder ?o . ?other gac:fieldOwner ?w ; gac:fieldSide ?s ; gac:fieldOrder ?o . FILTER(?other != $this) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:fieldName must be unique within an owner and side" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:fieldOwner ?w ; gac:fieldSide ?s ; gac:fieldName ?n . ?other gac:fieldOwner ?w ; gac:fieldSide ?s ; gac:fieldName ?n . FILTER(?other != $this) }""" ] .

gls:EnumValueShape a sh:NodeShape ;
    sh:targetClass gac:EnumValue ;
    sh:property [ sh:path gac:enumOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class gac:CapabilityField ] ;
    sh:property [ sh:path gac:enumOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:enumValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

gls:DialectShape a sh:NodeShape ;
    sh:targetClass gac:Dialect ;
    sh:property [ sh:path gac:dialectOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class gac:Registry ] ;
    sh:property [ sh:path gac:dialectName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:dialectOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:dialectKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "rdf" "other" ) ] ;
    sh:property [ sh:path gac:dialectResponseName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:dialectMediaType ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:dialectAlias ; sh:datatype xsd:string ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "gac:dialectOrder must be unique across dialects" ;
        sh:prefixes gls: ;
        sh:select """SELECT $this WHERE { $this gac:dialectOrder ?o . ?other gac:dialectOrder ?o . ?other a gac:Dialect . FILTER(?other != $this) }""" ] .

gls:RefusalCodeShape a sh:NodeShape ;
    sh:targetClass gac:RefusalCode ;
    sh:property [ sh:path gac:refusalCodeName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:refusalCodeOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:refusalCodeKind ; sh:maxCount 1 ; sh:datatype xsd:string ] .

gls:LawStepShape a sh:NodeShape ;
    sh:targetClass gac:LawStep ;
    sh:property [ sh:path gac:lawStepName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:lawStepOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:lawStepCeiling ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "observe" "select" "construct" ) ] .

gls:VocabularyEntryShape a sh:NodeShape ;
    sh:targetClass gac:VocabularyEntry ;
    sh:property [ sh:path gac:vocabOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "engines" "refusal_kinds" "regimes" "lease_ceilings" "lease_reasons"
                          "receipt_reasons" "policy_refusal_kinds" ) ] ;
    sh:property [ sh:path gac:vocabOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path gac:vocabValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

gls:LimitShape a sh:NodeShape ;
    sh:targetClass gac:Limit ;
    sh:property [ sh:path gac:limitName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gac:limitValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .
