@prefix sa2a: <https://graphlaw.dev/sa2a#> .
@prefix kh: <https://graphlaw.dev/knowledge-hook#> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

kh:FiboPaymentExecution a sa2a:CapabilityEvidence ;
  sa2a:contractVersion "v26.9.29" ;
  sa2a:canonicalization "RDFC-1.0" ;
  sa2a:authority "NONE" ;
  sa2a:consequence "EVIDENCE_ONLY" ;
  sa2a:requiresExactSubject true ;
  sa2a:requiresSourceDigest true ;
  sa2a:requiresReplayIdentity true ;
  kh:projectsThrough kh:HookCandidate ;
  kh:semanticSource fibo-fnd-rel-rel: ;
  sa2a:rule "FIBO changes semantic capability input only; it does not create a second authority, receipt, replay, or consequence system." ;
  prov:wasAttributedTo <https://graphlaw.dev/reference/factory-c> .
