@prefix sa2a: <https://graphlaw.dev/sa2a#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://graphlaw.dev/sa2a/replay/graph-digest> a sa2a:ReplayEvidence ;
  sa2a:contractVersion "v26.9.29" ;
  sa2a:canonicalization "RDFC-1.0" ;
  sa2a:authority "NONE" ;
  sa2a:consequence "EVIDENCE_ONLY" ;
  sa2a:requiresExactSubject true ;
  sa2a:requiresSourceDigest true ;
  sa2a:requiresReplayIdentity true ;
  sa2a:rule "Replay binds the canonical graph digest and refuses graph substitution." ;
  prov:wasAttributedTo <https://graphlaw.dev/sa2a/factory-b> .
