@prefix fleet: <https://graphlaw.dev/fleet#> .
@prefix sa2a: <https://graphlaw.dev/sa2a#> .
<https://graphlaw.dev/fleet/standing-release/v1> a fleet:StandingReleasePrimitive ;
 fleet:contractVersion "v26.9.30" ;
 fleet:canonicalOwner "seanchatmangpt/graphlaw" ;
 fleet:technicalStanding fleet:Qualified ;
 fleet:externalStanding fleet:Unspecified ;
 fleet:runtimeAuthority fleet:None ;
 fleet:requiresExactSubject true ;
 fleet:requiresAdmittedStanding true ;
 fleet:requiresReleaseBinding true ;
 fleet:requiresFrozenClosure true ;
 fleet:requiresAdvertisedExecutableEquality true ;
 fleet:requiresReceiptReplayBinding true ;
 fleet:refuseOnStaleStanding true ;
 fleet:refuseOnForgedStanding true ;
 fleet:refuseOnSubjectDrift true ;
 fleet:rule "TechnicalStanding, ExternalStanding, and RuntimeAuthority are independent dimensions." ;
 fleet:rule "A released capability is executable only for the exact admitted subject and exact frozen dependency-standing closure." ;
 fleet:rule "The advertised capability set equals the executable frozen closure." ;
 fleet:rule "Receipts and replay carry the exact standing and release binding used at admission." ;
 sa2a:authority "NONE" ;
 sa2a:consequence "EVIDENCE_ONLY" .
